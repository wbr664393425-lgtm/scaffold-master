# 复制为 .env 后按环境修改；compose 自动读取同目录 .env
# docker compose 从进程环境读取的变量会覆盖此文件，未设置的变量使用花括号内默认值

# JWT 签名密钥：至少 32 字节且不能全为空白，更换密钥会使旧 token 失效
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# 前端站点在宿主机暴露的端口
WEB_PORT=80

# 数据库：使用 compose 内置 mysql（--profile mysql）时保持 DB_HOST=mysql、DB_PORT=3306
# 复用宿主机已有 MySQL 时 DB_HOST=host.docker.internal，DB_PORT 改成该实例真实端口
# 漏改 DB_PORT 会退回 3306，打到宿主机上的另一个 MySQL 实例
DB_HOST=mysql
DB_PORT=3306
# 内置 mysql（--profile mysql）映射到宿主机的端口；本机 3306 被占用时改这里，不影响 DB_PORT
MYSQL_HOST_PORT=3306
DB_NAME=scaffold_system
DB_USERNAME=root
DB_PASSWORD=root
DB_TIMEZONE=+08:00

# JSON 序列化时区，须与 DB_TIMEZONE 对齐，否则日期整体偏移
JSON_TIMEZONE=GMT+8

# 登录图形验证码开关；生产保持 true
CAPTCHA_ENABLED=true
